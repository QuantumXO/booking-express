{
  "openapi": "3.1.1",
  "info": {
    "title": "Booking Express API",
    "version": "1.0.0",
    "description": "API documentation for the Booking Express service"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and session management endpoints"
    },
    {
      "name": "Users",
      "description": "User profile endpoints"
    },
    {
      "name": "Slots",
      "description": "Slot management endpoints"
    },
    {
      "name": "Bookings",
      "description": "Booking management endpoints"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "schemas": {
      "AccessTokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.signature"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.signature"
          }
        },
        "required": [
          "user",
          "accessToken"
        ]
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "cc995c90-d4c5-4131-8e5a-ea79a18cf6c3"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "0f7fd8de-b2c3-4cc9-9a2a-f09f1d3ef2ef"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "cancelled",
              "completed"
            ],
            "example": "pending"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "userId",
          "status",
          "createdAt"
        ]
      },
      "BookingErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Slot is not available for booking"
          }
        },
        "required": [
          "message"
        ]
      },
      "BookingListResponse": {
        "type": "object",
        "properties": {
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingDto"
            }
          }
        },
        "required": [
          "bookings"
        ]
      },
      "ContractorSlotListResponse": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotDto"
            }
          }
        },
        "required": [
          "slots"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "slotId"
        ]
      },
      "CreateBookingResponse": {
        "type": "object",
        "properties": {
          "booking": {
            "$ref": "#/components/schemas/BookingDto"
          }
        },
        "required": [
          "booking"
        ]
      },
      "CreateSlotDto": {
        "type": "object",
        "properties": {
          "contractorId": {
            "type": "string",
            "format": "uuid"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "contractorId",
          "startAt",
          "endAt"
        ],
        "additionalProperties": false
      },
      "CreateSlotResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "$ref": "#/components/schemas/Slot"
          }
        },
        "required": [
          "slot"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid request payload"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorDetail"
            }
          }
        },
        "required": [
          "message"
        ]
      },
      "GetSlotsQueryDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100,
            "default": 20
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 1
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24,
            "format": "password",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "User password",
            "example": "secret123"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "PaginatedContractorSlotListResponse": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/SlotsPaginationDto"
          }
        },
        "required": [
          "slots",
          "pagination"
        ]
      },
      "PatchSlotDto": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PatchSlotResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "$ref": "#/components/schemas/SlotDto"
          }
        },
        "required": [
          "slot"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0f7fd8de-b2c3-4cc9-9a2a-f09f1d3ef2ef"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "contractor",
                "admin"
              ]
            },
            "example": [
              "contractor"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-17T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-17T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "roles",
          "createdAt",
          "updatedAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24,
            "format": "password",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "User password",
            "example": "secret123"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "Slot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "cc995c90-d4c5-4131-8e5a-ea79a18cf6c3"
          },
          "contractorId": {
            "type": "string",
            "format": "uuid",
            "example": "0f7fd8de-b2c3-4cc9-9a2a-f09f1d3ef2ef"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "example": 500
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T10:00:00.000Z"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T11:00:00.000Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "contractorId",
          "startAt",
          "endAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "SlotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "cc995c90-d4c5-4131-8e5a-ea79a18cf6c3"
          },
          "booked": {
            "type": "boolean",
            "example": false
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "example": 500
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T10:00:00.000Z"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T11:00:00.000Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "startAt",
          "endAt",
          "createdAt"
        ]
      },
      "SlotListResponse": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotWithContractorDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/SlotsPaginationDto"
          }
        },
        "required": [
          "slots",
          "pagination"
        ]
      },
      "SlotsErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Slot not found"
          }
        },
        "required": [
          "message"
        ]
      },
      "SlotsPaginationDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "example": 1
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "example": 20
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "example": 47
          },
          "pages": {
            "type": "integer",
            "minimum": 0,
            "example": 3
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "pages"
        ]
      },
      "SlotWithContractorDto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SlotDto"
          },
          {
            "type": "object",
            "properties": {
              "contractor": {
                "$ref": "#/components/schemas/PublicUserDto"
              }
            },
            "required": [
              "contractor"
            ]
          }
        ]
      },
      "UsersErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "User not found"
          }
        },
        "required": [
          "message"
        ]
      },
      "ValidationErrorDetail": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "Invalid email"
          }
        },
        "required": [
          "path",
          "message"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUserDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              },
              "example": {
                "email": "",
                "password": ""
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature; Path=/auth/refresh; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "example": {
                "email": "",
                "password": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature; Path=/auth/refresh; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "refresh",
        "security": [
          {
            "refreshTokenCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": ""
            },
            "required": true,
            "name": "refreshToken",
            "in": "cookie"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature; Path=/auth/refresh; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": ""
            },
            "required": false,
            "name": "refreshToken",
            "in": "cookie"
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        }
      }
    },
    "/slots": {
      "get": {
        "tags": [
          "Slots"
        ],
        "operationId": "getSlots",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "active",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Slots"
        ],
        "operationId": "createSlot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSlotDto"
              },
              "example": {
                "contractorId": "0f7fd8de-b2c3-4cc9-9a2a-f09f1d3ef2ef",
                "price": 500,
                "startAt": "2026-04-22T10:00:00.000Z",
                "endAt": "2026-04-22T11:00:00.000Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/slots/my": {
      "get": {
        "tags": [
          "Slots"
        ],
        "operationId": "getContractorSlots",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractorSlotListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/slots/{contractorId}": {
      "get": {
        "tags": [
          "Slots"
        ],
        "operationId": "getSlotsByContractorId",
        "parameters": [
          {
            "name": "contractorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "0f7fd8de-b2c3-4cc9-9a2a-f09f1d3ef2ef"
            }
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "active",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedContractorSlotListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/slots/{slotId}": {
      "delete": {
        "tags": [
          "Slots"
        ],
        "operationId": "deleteSlot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "cc995c90-d4c5-4131-8e5a-ea79a18cf6c3"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        }
      },
      "patch": {
        "tags": [
          "Slots"
        ],
        "operationId": "patchSlot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "cc995c90-d4c5-4131-8e5a-ea79a18cf6c3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSlotDto"
              },
              "example": {
                "price": 700,
                "startAt": "2026-04-22T12:00:00.000Z",
                "endAt": "2026-04-22T13:00:00.000Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
